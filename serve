#!/bin/sh
# ./serve [host] [port] : run exocalendar from this clone, in the foreground.
# With no arguments the bind and port come from config.toml (127.0.0.1:5232
# before the first run). A first run with no config serves the setup form.
set -eu
cd "$(dirname "$0")"
exec python3 -m exocalendar serve ${1:+--bind "$1"} ${2:+--port "$2"}
