# systemd user unit for exocalendar (installable-contract file for boxes that
# deploy from this repo; the app itself is host-agnostic and needs none of this
# — `exocalendar serve` from any shell is a complete deployment).
#
# Note: %h expands in Exec* and Environment lines on modern systemd, but some
# house deploy tooling templates absolute paths — keep ExecStart absolute if
# this unit misbehaves. PATH is set because systemd user units do not inherit
# a login shell's PATH (~/.local/bin is where pip --user puts the script).

[Unit]
Description=exocalendar CalDAV server
After=network.target

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/exocalendar serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
